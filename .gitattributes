# Normalize line endings to LF in the repository
* text=auto eol=lf
*.php text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
