{
  "name": "wp-heart/wp-heart",
  "description": "Database Observatory & Intelligence Platform for WordPress (metadata only, no runtime deps)",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10",
    "wp-coding-standards/wpcs": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "WPHeart\\": "src/WPHeart/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "phpcs --standard=phpcs.xml",
    "analyse": "phpstan analyse -c phpstan.neon"
  },
  "config": {
    "allow-plugins": {}
  }
}
